# =============================================================================
# AUTO ROI — Variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs
# JAMAIS committer .env.local !
# =============================================================================

# ─── Supabase (requis) ────────────────────────────────────────────────────────
# Disponible dans : Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Site ─────────────────────────────────────────────────────────────────────
# En production : https://autoroi.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Contact ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=+33600000000
NEXT_PUBLIC_PHONE_NUMBER=+33600000000
NEXT_PUBLIC_EMAIL=contact@autoroi.fr

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Clé secrète pour le webhook de revalidation (ISR)
REVALIDATE_SECRET=your_revalidate_secret

# ─── Email (Resend — notifications de contact & location) ──────────────────
# https://resend.com
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=your_admin_email@example.com

# ─── Stripe (Location — acompte) ──────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# En dev : utiliser les clés sk_test_ / pk_test_
# En prod : utiliser les clés sk_live_ / pk_live_
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Webhook production : créer sur https://dashboard.stripe.com/webhooks
#   URL = https://autoroi.fr/api/webhooks/stripe-rental
#   Événements = checkout.session.completed, checkout.session.expired

# ─── Sentry (monitoring erreurs) ──────────────────────────────────────────
# https://sentry.io > Settings > Projects > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@o123.ingest.sentry.io/456
SENTRY_DSN=https://your_dsn@o123.ingest.sentry.io/456
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
# Auth token pour upload des source maps (optionnel en dev)
# https://sentry.io > Settings > Auth Tokens
SENTRY_AUTH_TOKEN=

# ─── E2E Tests (optionnel — uniquement pour Playwright) ───────────────────
E2E_ADMIN_EMAIL=your_test_email@example.com
E2E_ADMIN_PASSWORD=your_password_here
