# =============================================================================
# AUTO ROI — Variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs
# JAMAIS committer .env.local !
# =============================================================================

# ─── Supabase (requis) ────────────────────────────────────────────────────────
# Disponible dans : Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://[ton-projet].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ta-clé-anon-publique]
SUPABASE_SERVICE_ROLE_KEY=[ta-clé-service-role-privée]

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Contact ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=33600000000
NEXT_PUBLIC_PHONE_NUMBER=+33600000000
NEXT_PUBLIC_EMAIL=contact@autoroi.fr

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Clé secrète pour le webhook de revalidation (ISR)
REVALIDATE_SECRET=change_this_secret_in_production

# ─── Email (optionnel — pour les notifications de contact) ────────────────────
# https://resend.com
RESEND_API_KEY=re_HpD4F6Kc_JHdFwS3BtvHmgECWjHGype1N

# ─── Sentry (monitoring erreurs) ─────────────────────────────────────────────
# https://sentry.io > Settings > Projects > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
SENTRY_ORG=auto-roi
SENTRY_PROJECT=auto-roi-web
# Auth token pour upload des source maps (optionnel en dev)
# https://sentry.io > Settings > Auth Tokens
SENTRY_AUTH_TOKEN=
